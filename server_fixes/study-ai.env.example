# Both roles use an OpenAI-compatible /chat/completions endpoint.
# Fill BASE_URL, MODEL and API_KEY together for each role that should be enabled.
# Keep real keys in the server environment. These fields are independent.

LOVEGIRL_STUDY_OCR_BASE_URL=https://api.deepseek.com
LOVEGIRL_STUDY_OCR_MODEL=deepseek-flash
LOVEGIRL_STUDY_OCR_LABEL=DeepSeek
LOVEGIRL_STUDY_OCR_API_KEY=

LOVEGIRL_STUDY_TEXT_BASE_URL=https://api.deepseek.com
LOVEGIRL_STUDY_TEXT_MODEL=deepseek-flash
LOVEGIRL_STUDY_TEXT_LABEL=DeepSeek
LOVEGIRL_STUDY_TEXT_API_KEY=

# For another provider, replace that role's base URL, model, label and key.
# OCR requires image_url with inline JPEG data. TEXT requires JSON output mode.
