# LoveGirl Backend Environment Variables
# Copy this file to .env and fill in the values

# Database
DB_HOST=localhost
DB_USER=lovegirl
DB_PASS=your_database_password_here
DB_NAME=love_girl

# Server
PORT=3001
NODE_ENV=production

# Deploy API Token (REQUIRED - no fallback)
DEPLOY_TOKEN=your_deploy_token_here

# Gaode (AMap) Web Service API Key (backend only: POI/geocode/direction/weather)
AMAP_WEB_KEY=your_amap_web_service_key_here
# Backward-compatible fallback used by older weather code
GAODE_API_KEY=your_gaode_api_key_here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://47.121.119.191:3001
