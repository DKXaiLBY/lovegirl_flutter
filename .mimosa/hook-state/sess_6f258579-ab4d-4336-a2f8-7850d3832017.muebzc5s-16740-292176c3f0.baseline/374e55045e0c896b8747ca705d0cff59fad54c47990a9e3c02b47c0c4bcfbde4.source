import io, re, os

def rd(p):
    return io.open(p, encoding='utf-8').read()

def wr(p, s):
    io.open(p, 'w', encoding='utf-8', newline='').write(s)

# ---------- 1) travel: _buildInfoSection + _infoRow ----------
p = 'lib/screens/travel/travel_main_screen.dart'
s = rd(p)
s = s.replace("""Widget _infoRow(context, BuildContext context, IconData icon, String label,
      String value) {""",
"""Widget _infoRow(BuildContext context, IconData icon, String label,
      String value) {""")
s = s.replace("Widget _buildInfoSection(TravelSpot spot) {",
              "Widget _buildInfoSection(BuildContext context, TravelSpot spot) {")
s = s.replace("_buildInfoSection(spot)", "_buildInfoSection(context, spot)")
s = s.replace("_buildInfoSection(", "_buildInfoSection(context, ") if "_buildInfoSection(spot)" not in rd(p) else s
wr(p, s)

# ---------- 2) mood: constructor init + nullable usages ----------
p = 'lib/screens/mood/mood_screen.dart'
s = rd(p)
s = s.replace("""      this.label = '',
      this.note = '',
      this.raw = const {}});
  factory MoodData.empty() => MoodData(hasMood: false);""",
"""      this.label = '',
      this.note = '',
      this.raw = const {}})
      : color = color;
  factory MoodData.empty() => MoodData(hasMood: false);""")
s = s.replace("color: mood.color.withAlpha(30), shape: BoxShape.circle),",
              "color: (mood.color ?? context.lgTextMuted).withAlpha(30),\n                  shape: BoxShape.circle),")
s = s.replace("child: Icon(mood.icon, size: 40, color: mood.color),",
              "child: Icon(mood.icon,\n                    size: 40, color: mood.color ?? context.lgTextMuted),")
s = s.replace("""                    fontWeight: FontWeight.bold,
                    color: mood.color)),""",
"""                    fontWeight: FontWeight.bold,
                    color: mood.color ?? context.lgTextMuted)),""")
s = s.replace("? mood.color.withAlpha(180)",
              "? (mood.color ?? context.lgTextMuted).withAlpha(180)")
wr(p, s)

# ---------- 3) lovegirl_ui: barcode/icon-button init + painter colors + const ----------
p = 'lib/widgets/lovegirl_ui.dart'
s = rd(p)
s = s.replace("""  const LoveBarcode({
    super.key,
    Color? color,
    this.width = 52,
    this.height = 38,
  });""",
"""  const LoveBarcode({
    super.key,
    Color? color,
    this.width = 52,
    this.height = 38,
  }) : color = color;""")
s = s.replace("""  LoveIconButton({
    super.key,
    required this.icon,
    this.onTap,
    this.tooltip,
    Color? color,
    this.isActive = false,
  });""",
"""  const LoveIconButton({
    super.key,
    required this.icon,
    this.onTap,
    this.tooltip,
    Color? color,
    this.isActive = false,
  }) : color = color;""")
s = s.replace("painter: _TicketBorderPainter(),",
              "painter: _TicketBorderPainter(separator: context.lgSeparator),")
s = s.replace("""class _TicketBorderPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [
          Colors.white.withAlpha(210),
          context.lgSeparator.withAlpha(150),
          context.lgSeparator.withAlpha(120),
        ],
      ).createShader(Offset.zero & size);""",
"""class _TicketBorderPainter extends CustomPainter {
  final Color separator;

  _TicketBorderPainter({required this.separator});

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [
          Colors.white.withAlpha(210),
          separator.withAlpha(150),
          separator.withAlpha(120),
        ],
      ).createShader(Offset.zero & size);""")
wr(p, s)

# ---------- 4) kitchen: _statusColor getter -> method ----------
p = 'lib/screens/kitchen/kitchen_screen.dart'
s = rd(p)
s = s.replace("""  Color get _statusColor {
    switch (order.status) {
      case 'placed':
        return LoveGirlTheme.orange;
      case 'accepted':
        return LoveGirlTheme.primary;
      case 'done':
        return LoveGirlTheme.secondary;
      default:
        return context.lgTextMuted;
    }
  }""",
"""  Color _statusColor(BuildContext context) {
    switch (order.status) {
      case 'placed':
        return LoveGirlTheme.orange;
      case 'accepted':
        return LoveGirlTheme.primary;
      case 'done':
        return LoveGirlTheme.secondary;
      default:
        return context.lgTextMuted;
    }
  }""")
s = s.replace("_statusColor", "_statusColor(context)")
s = s.replace("Color _statusColor(context)(BuildContext context)", "Color _statusColor(BuildContext context)")
wr(p, s)

# ---------- 5) period_tracker: regularityColor getter -> method ----------
p = 'lib/screens/health/widgets/period_tracker.dart'
s = rd(p)
s = s.replace("""  Color get regularityColor {
    switch (regularity) { case 'regular': return const Color(0xFF4CAF50); case 'irregular': return const Color(0xFFFF9800); default: return context.lgTextMuted; }
  }""",
"""  Color regularityColor(BuildContext context) {
    switch (regularity) { case 'regular': return const Color(0xFF4CAF50); case 'irregular': return const Color(0xFFFF9800); default: return context.lgTextMuted; }
  }""")
s = s.replace("a.regularityColor.withAlpha(25)", "a.regularityColor(context).withAlpha(25)")
s = s.replace("color: a.regularityColor,", "color: a.regularityColor(context),")
wr(p, s)
print('batch fixes applied')
