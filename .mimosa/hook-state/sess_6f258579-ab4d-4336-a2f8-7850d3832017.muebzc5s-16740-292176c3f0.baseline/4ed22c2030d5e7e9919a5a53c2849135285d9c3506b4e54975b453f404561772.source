import subprocess, re, io, collections, os

def analyze():
    r = subprocess.run(['D:/flutter-sdk/bin/flutter.bat', 'analyze'],
                       capture_output=True, text=True, timeout=300,
                       cwd='D:/lovegirl_flutter')
    errs = []
    rx = re.compile(r'\s*error - (.+?) - (.+?):(\d+):(\d+) - (.+)$')
    for line in r.stdout.splitlines():
        m = rx.match(line.rstrip())
        if not m:
            continue
        errs.append((m.group(2).replace(os.sep, '/'),
                     int(m.group(3)), int(m.group(4)),
                     m.group(1), m.group(5)))
    return errs

for it in range(30):
    errs = analyze()
    cnnc = [e for e in errs if e[4] == 'const_with_non_const']
    other = [e for e in errs if e[4] != 'const_with_non_const']
    print('iter', it, 'const_with_non_const', len(cnnc), 'other-errors', len(other))
    if not cnnc:
        for e in other[:15]:
            print('  OTHER', e[0], e[1], e[4], '-', e[3])
        print('DONE-CONST-LOOP')
        break
    byfile = collections.defaultdict(list)
    for f, ln, col, _m, _code in cnnc:
        byfile[f].append((ln, col))
    for f, spots in byfile.items():
        src = io.open(f, encoding='utf-8').read().splitlines(keepends=True)
        for ln, col in sorted(set(spots), reverse=True):
            text = src[ln - 1]
            idx = col - 1
            # locate the const keyword at/near reported column
            m = re.search(r'\bconst\s', text[idx:] if idx < len(text) else '')
            if m is None:
                m = re.search(r'\bconst\s', text)
                if m is None:
                    print('  MISS', f, ln, col)
                    continue
                idx = m.start()
            else:
                idx = idx + m.start()
            src[ln - 1] = text[:idx] + text[idx + len('const '):]
        io.open(f, 'w', encoding='utf-8', newline='').write(''.join(src))
